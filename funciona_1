<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TimeBack | Tu extensión de memoria</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Space+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#07070d;
  --cyan:#00E5FF;
  --purple:#9D00FF;
  --pink:#FF2D78;
  --text:#dde0ff;
  --muted:#6a6d8a;
  --glass:rgba(14,14,28,0.6);
  --border:rgba(0,229,255,0.15);
  --sidebar:240px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--bg);
  background-image:
    radial-gradient(ellipse 80% 50% at 50% -10%,rgba(157,0,255,0.15),transparent),
    radial-gradient(ellipse 50% 40% at 100% 60%,rgba(0,229,255,0.06),transparent);
  color:var(--text);
  font-family:'Space Grotesk',sans-serif;
  min-height:100vh;
  display:flex;
  overflow-x:hidden;
}

/* ── SIDEBAR ── */
.sidebar{
  width:var(--sidebar);
  background:rgba(4,4,12,0.92);
  backdrop-filter:blur(20px);
  border-right:1px solid var(--border);
  height:100vh;
  position:fixed;
  top:0;left:0;
  display:flex;
  flex-direction:column;
  padding:28px 18px;
  z-index:50;
}
.logo{
  font-family:'Orbitron',sans-serif;
  font-size:22px;
  font-weight:900;
  color:#fff;
  text-shadow:0 0 18px var(--cyan);
  display:flex;
  align-items:center;
  gap:9px;
  margin-bottom:40px;
}
.rec-dot{
  width:9px;height:9px;
  border-radius:50%;
  background:#ff2a2a;
  box-shadow:0 0 10px #ff2a2a;
  animation:pulse 1.5s infinite;
  flex-shrink:0;
}
.nav{list-style:none;display:flex;flex-direction:column;gap:4px}
.nav-item{
  padding:12px 14px;
  border-radius:10px;
  cursor:pointer;
  transition:.25s;
  font-family:'Orbitron',sans-serif;
  font-size:11px;
  color:var(--muted);
  display:flex;
  align-items:center;
  gap:10px;
  letter-spacing:.04em;
  border-left:3px solid transparent;
}
.nav-item:hover,.nav-item.active{
  background:rgba(0,229,255,0.08);
  color:var(--cyan);
  border-left-color:var(--cyan);
}
.nav-item .icon{font-size:15px;width:20px;text-align:center}

/* recording mode pill */
.mode-badge{
  display:inline-flex;
  align-items:center;
  gap:6px;
  background:rgba(0,229,255,0.1);
  border:1px solid var(--border);
  border-radius:20px;
  padding:5px 12px;
  font-size:10px;
  font-family:'Orbitron',sans-serif;
  color:var(--cyan);
  cursor:pointer;
  transition:.2s;
}
.mode-badge:hover{background:rgba(0,229,255,0.18)}

.sys-status{
  margin-top:auto;
  padding:14px;
  background:var(--glass);
  border:1px solid var(--border);
  border-radius:10px;
  font-size:10.5px;
  font-family:'Orbitron',sans-serif;
  line-height:1.8;
  color:var(--muted);
}
.sys-status .on{color:var(--cyan)}

/* ── MAIN ── */
.main{
  margin-left:var(--sidebar);
  flex:1;
  padding:36px 44px;
  min-height:100vh;
}
.section{display:none;animation:fadeUp .35s ease}
.section.active{display:block}
@keyframes fadeUp{
  from{opacity:0;transform:translateY(12px)}
  to{opacity:1;transform:translateY(0)}
}

/* ── HEADER ── */
.hdr{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  margin-bottom:28px;
  border-bottom:1px solid var(--border);
  padding-bottom:18px;
}
.page-title{
  font-family:'Orbitron',sans-serif;
  font-size:1.75rem;
  color:#fff;
  letter-spacing:.02em;
}
.sub{color:var(--muted);font-size:13px;margin-top:4px}

/* ── GLASS CARD ── */
.glass{
  background:var(--glass);
  border:1px solid var(--border);
  border-radius:14px;
  padding:22px;
  backdrop-filter:blur(14px);
}

/* ── STATS ── */
.stats-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
  margin-bottom:28px;
}
.stat{
  background:var(--glass);
  border:1px solid var(--border);
  border-radius:14px;
  padding:20px 22px;
  position:relative;
  overflow:hidden;
  transition:.25s;
}
.stat::before{
  content:'';
  position:absolute;
  top:0;right:0;
  width:60px;height:60px;
  border-radius:0 0 0 60px;
  background:linear-gradient(135deg,var(--cyan),var(--purple));
  opacity:.08;
}
.stat:hover{border-color:rgba(0,229,255,0.35)}
.stat-num{
  font-family:'Orbitron',sans-serif;
  font-size:2rem;
  font-weight:900;
  color:#fff;
  line-height:1;
  margin-bottom:6px;
}
.stat-label{font-size:11px;color:var(--muted);font-family:'Orbitron',sans-serif;letter-spacing:.06em}
.stat-trend{
  font-size:11px;
  color:var(--cyan);
  margin-top:8px;
}

/* ── ACTIVITY FEED ── */
.activity-list{display:flex;flex-direction:column;gap:12px}
.activity-item{
  display:flex;
  align-items:center;
  gap:14px;
  padding:14px 16px;
  background:rgba(255,255,255,0.02);
  border:1px solid rgba(255,255,255,0.06);
  border-radius:10px;
  transition:.2s;
  cursor:pointer;
}
.activity-item:hover{border-color:var(--border);background:rgba(0,229,255,0.04)}
.act-icon{
  width:40px;height:40px;
  border-radius:10px;
  display:flex;align-items:center;justify-content:center;
  font-size:18px;
  flex-shrink:0;
}
.act-info{flex:1}
.act-title{font-size:14px;font-weight:600;color:#fff;margin-bottom:2px}
.act-meta{font-size:11px;color:var(--muted)}
.act-bpm{
  font-family:'Orbitron',sans-serif;
  font-size:13px;
  color:var(--purple);
}
.emo-pill{
  display:inline-block;
  padding:3px 10px;
  border-radius:20px;
  font-size:10px;
  font-family:'Orbitron',sans-serif;
  margin-top:4px;
}

/* ── VAULT SEARCH ── */
.search-wrap{
  position:relative;
  margin-bottom:20px;
}
.search-wrap input{
  width:100%;
  background:rgba(255,255,255,0.04);
  border:1px solid var(--border);
  color:#fff;
  padding:13px 20px 13px 48px;
  border-radius:12px;
  outline:none;
  font-size:14px;
  font-family:'Space Grotesk',sans-serif;
  transition:.2s;
}
.search-wrap input:focus{
  border-color:var(--cyan);
  box-shadow:0 0 0 3px rgba(0,229,255,0.1);
}
.search-wrap input::placeholder{color:var(--muted)}
.search-icon{
  position:absolute;
  left:16px;top:50%;
  transform:translateY(-50%);
  color:var(--muted);
  font-size:18px;
  pointer-events:none;
}

/* ── FILTERS ── */
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px}
.filter-btn{
  background:transparent;
  border:1px solid var(--border);
  color:var(--muted);
  padding:7px 16px;
  border-radius:20px;
  cursor:pointer;
  font-size:12px;
  font-family:'Orbitron',sans-serif;
  transition:.2s;
  letter-spacing:.04em;
}
.filter-btn:hover,.filter-btn.active{
  background:var(--cyan);
  color:#020208;
  border-color:var(--cyan);
  box-shadow:0 0 14px rgba(0,229,255,0.35);
}

/* ── MEMORY GRID ── */
.mem-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(270px,1fr));
  gap:20px;
}
.mem-card{
  background:var(--glass);
  border:1px solid var(--border);
  border-radius:14px;
  overflow:hidden;
  cursor:pointer;
  transition:.3s;
  position:relative;
}
.mem-card:hover{
  transform:translateY(-5px);
  border-color:rgba(0,229,255,0.4);
  box-shadow:0 8px 30px rgba(0,229,255,0.12);
}
.sensitive-badge{
  position:absolute;
  top:10px;right:10px;
  background:rgba(255,45,120,0.85);
  color:#fff;
  font-size:9px;
  font-family:'Orbitron',sans-serif;
  padding:4px 9px;
  border-radius:10px;
  letter-spacing:.05em;
  z-index:2;
}
.mem-img{
  width:100%;
  height:145px;
  background-size:cover;
  background-position:center;
  display:flex;align-items:center;justify-content:center;
  position:relative;
}
.mem-img::after{
  content:'';
  position:absolute;inset:0;
  background:linear-gradient(to bottom,transparent 40%,rgba(7,7,13,0.85));
}
.mem-play{
  font-size:28px;
  color:rgba(255,255,255,0.7);
  position:relative;z-index:1;
  transition:.2s;
}
.mem-card:hover .mem-play{color:var(--cyan);transform:scale(1.1)}
.mem-body{padding:16px}
.mem-row{
  display:flex;
  justify-content:space-between;
  font-size:10px;
  color:var(--cyan);
  font-family:'Orbitron',sans-serif;
  margin-bottom:10px;
  letter-spacing:.04em;
}
.mem-title{font-size:1rem;font-weight:600;color:#fff;margin-bottom:8px}
.mem-metrics{display:flex;gap:12px;font-size:11px;color:var(--muted)}
.mem-metrics span{color:var(--purple);font-weight:600}

/* ── ANALYTICS SVG CHART ── */
.chart-wrap{
  width:100%;
  background:rgba(0,0,0,0.3);
  border-radius:10px;
  overflow:hidden;
  margin-bottom:20px;
}
.emo-bars{display:flex;flex-direction:column;gap:14px}
.emo-row{display:flex;flex-direction:column;gap:5px}
.emo-label{display:flex;justify-content:space-between;font-size:12px}
.emo-label span:last-child{color:var(--cyan)}
.bar-bg{background:rgba(255,255,255,0.07);border-radius:6px;height:8px;overflow:hidden}
.bar-fill{height:100%;border-radius:6px;transition:width 1s ease}
.bar-cyan{background:linear-gradient(90deg,var(--cyan),#00b0cc)}
.bar-purple{background:linear-gradient(90deg,var(--purple),#7700cc)}
.bar-pink{background:linear-gradient(90deg,var(--pink),#cc1f60)}
.bar-green{background:linear-gradient(90deg,#00ff99,#00cc77)}

/* ── SETTINGS ── */
.setting{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:16px 0;
  border-bottom:1px solid rgba(255,255,255,0.05);
}
.setting:last-child{border:none}
.setting-info h4{font-size:14px;font-weight:600;color:#fff;margin-bottom:4px}
.setting-info p{font-size:11px;color:var(--muted)}
.switch{position:relative;display:inline-block;width:48px;height:24px}
.switch input{opacity:0;width:0;height:0}
.slider{
  position:absolute;inset:0;
  background:rgba(255,255,255,0.1);
  border-radius:24px;
  border:1px solid var(--border);
  cursor:pointer;
  transition:.3s;
}
.slider::before{
  content:'';
  position:absolute;
  width:16px;height:16px;
  left:3px;bottom:3px;
  border-radius:50%;
  background:var(--muted);
  transition:.3s;
}
input:checked+.slider{background:var(--purple);border-color:var(--purple)}
input:checked+.slider::before{transform:translateX(24px);background:#fff;box-shadow:0 0 8px #fff}

/* ── CLOUD ── */
.storage-ring{
  width:140px;height:140px;
  border-radius:50%;
  border:3px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;
  margin:20px auto;
  position:relative;
}
.ring-svg{position:absolute;top:-3px;left:-3px}
.storage-num{font-family:'Orbitron',sans-serif;font-size:1.4rem;font-weight:900;color:#fff}
.storage-sub{font-size:11px;color:var(--muted)}

/* ── PROGRESS ── */
.prog-wrap{background:rgba(255,255,255,0.07);border-radius:10px;height:8px;overflow:hidden;margin-top:8px}
.prog-bar{height:100%;background:linear-gradient(90deg,var(--cyan),var(--purple));border-radius:10px}

/* ── FLOATING AI ── */
.ai-fab{
  position:fixed;
  bottom:32px;right:28px;
  width:56px;height:56px;
  border-radius:50%;
  border:none;
  background:linear-gradient(135deg,var(--cyan),var(--purple));
  color:#fff;
  font-size:22px;
  cursor:pointer;
  z-index:400;
  box-shadow:0 4px 24px rgba(0,229,255,0.45);
  transition:.25s;
  display:flex;align-items:center;justify-content:center;
}
.ai-fab:hover{transform:scale(1.1);box-shadow:0 6px 32px rgba(0,229,255,0.6)}

/* ── AI PANEL ── */
.ai-panel{
  position:fixed;
  bottom:100px;right:28px;
  width:360px;
  background:rgba(6,6,18,0.96);
  border:1px solid var(--border);
  border-radius:18px;
  box-shadow:0 20px 60px rgba(0,0,0,0.7);
  display:none;
  flex-direction:column;
  overflow:hidden;
  z-index:399;
  backdrop-filter:blur(20px);
  animation:slideUp .25s ease;
}
.ai-panel.open{display:flex}
@keyframes slideUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.ai-panel-hdr{
  padding:16px 18px;
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:10px;
  background:rgba(0,229,255,0.05);
}
.ai-panel-hdr .ai-dot{
  width:8px;height:8px;
  border-radius:50%;
  background:var(--cyan);
  box-shadow:0 0 8px var(--cyan);
  animation:pulse 2s infinite;
}
.ai-title{font-family:'Orbitron',sans-serif;font-size:12px;color:var(--cyan);flex:1;letter-spacing:.05em}
.ai-close{
  background:none;border:none;color:var(--muted);
  font-size:18px;cursor:pointer;transition:.2s;line-height:1;
}
.ai-close:hover{color:#fff}
.ai-messages{
  flex:1;
  padding:16px;
  overflow-y:auto;
  display:flex;
  flex-direction:column;
  gap:10px;
  min-height:220px;
  max-height:320px;
}
.ai-messages::-webkit-scrollbar{width:4px}
.ai-messages::-webkit-scrollbar-track{background:transparent}
.ai-messages::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px}
.msg{
  padding:10px 13px;
  border-radius:12px;
  font-size:13px;
  line-height:1.5;
  max-width:85%;
}
.msg.assistant{
  background:rgba(0,229,255,0.08);
  border:1px solid rgba(0,229,255,0.15);
  align-self:flex-start;
  color:var(--text);
}
.msg.user{
  background:rgba(157,0,255,0.15);
  border:1px solid rgba(157,0,255,0.25);
  align-self:flex-end;
  color:#fff;
}
.msg.thinking{
  font-style:italic;color:var(--muted);
  animation:blink 1.2s infinite;
}
.ai-input-row{
  padding:12px 14px;
  border-top:1px solid var(--border);
  display:flex;gap:10px;
}
.ai-input{
  flex:1;
  background:rgba(255,255,255,0.05);
  border:1px solid var(--border);
  border-radius:10px;
  color:#fff;
  padding:9px 14px;
  font-size:13px;
  font-family:'Space Grotesk',sans-serif;
  outline:none;
  transition:.2s;
}
.ai-input:focus{border-color:var(--cyan)}
.ai-input::placeholder{color:var(--muted)}
.ai-send{
  background:linear-gradient(135deg,var(--cyan),var(--purple));
  border:none;
  border-radius:10px;
  color:#fff;
  padding:9px 14px;
  cursor:pointer;
  font-size:15px;
  transition:.2s;
}
.ai-send:hover{opacity:.85}
.ai-send:disabled{opacity:.4;cursor:not-allowed}

/* ── MODAL IMMERSIVE ── */
.modal{
  display:none;
  position:fixed;inset:0;
  background:rgba(0,0,0,0.97);
  z-index:1000;
  justify-content:center;
  align-items:center;
  flex-direction:column;
}
.modal.open{display:flex}
.modal-close{
  position:absolute;top:24px;right:32px;
  color:#fff;font-size:36px;cursor:pointer;
  transition:.2s;
  background:none;border:none;
  font-family:sans-serif;line-height:1;
  z-index:2;
}
.modal-close:hover{color:var(--cyan)}
.sync-phase{
  font-family:'Orbitron',sans-serif;
  font-size:20px;
  color:var(--cyan);
  text-align:center;
  animation:blink 1s infinite;
  padding:20px;
}
.pov-wrap{
  display:none;
  width:84%;height:82vh;
  border:1.5px solid var(--cyan);
  border-radius:18px;
  box-shadow:0 0 50px rgba(0,229,255,0.2);
  position:relative;
  overflow:hidden;
}
.pov-bg{
  position:absolute;inset:0;
  background-size:cover;
  background-position:center;
  filter:brightness(.75);
  transition:filter 1s;
}
.pov-vignette{
  position:absolute;inset:0;
  background:radial-gradient(circle,transparent 35%,rgba(0,0,0,0.85) 100%);
  border-radius:16px;
}
.pov-hud{
  position:absolute;inset:0;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  padding:24px 28px;
  z-index:2;
}
.hud-row{display:flex;justify-content:space-between;align-items:flex-start}
.hud-el{
  font-family:'Orbitron',sans-serif;
  font-size:12px;
  color:var(--cyan);
  letter-spacing:.06em;
  text-shadow:0 0 10px rgba(0,229,255,0.6);
}
.hud-el.purple{color:var(--purple);text-shadow:0 0 10px rgba(157,0,255,0.6)}
.hud-center{text-align:center;color:rgba(255,255,255,0.6);font-size:13px}
.bpm-live{
  font-family:'Orbitron',sans-serif;
  font-size:24px;
  color:var(--pink);
  text-shadow:0 0 12px rgba(255,45,120,0.7);
}
.bpm-label{font-size:10px;color:var(--muted);font-family:'Orbitron',sans-serif}
.emo-hud{
  padding:5px 12px;
  border:1px solid rgba(0,229,255,0.3);
  border-radius:20px;
  font-family:'Orbitron',sans-serif;
  font-size:11px;
  color:var(--cyan);
  background:rgba(0,229,255,0.08);
}
.playback-controls{
  display:flex;gap:14px;align-items:center;justify-content:center;
}
.ctrl-btn{
  background:rgba(255,255,255,0.12);
  border:1px solid rgba(255,255,255,0.15);
  color:#fff;
  width:40px;height:40px;
  border-radius:50%;
  cursor:pointer;
  font-size:14px;
  display:flex;align-items:center;justify-content:center;
  transition:.2s;
}
.ctrl-btn:hover{background:rgba(0,229,255,0.2);border-color:var(--cyan)}
.ctrl-btn.main{width:54px;height:54px;font-size:18px;background:rgba(0,229,255,0.2);border-color:var(--cyan)}

/* ── SENSITIVE MODAL ── */
.sens-modal{
  display:none;
  position:fixed;inset:0;
  background:rgba(0,0,0,0.92);
  z-index:1100;
  justify-content:center;
  align-items:center;
}
.sens-modal.open{display:flex}
.sens-box{
  background:rgba(10,8,20,0.98);
  border:1px solid rgba(255,45,120,0.4);
  border-radius:18px;
  padding:36px;
  text-align:center;
  max-width:380px;
  box-shadow:0 0 40px rgba(255,45,120,0.15);
}
.sens-icon{font-size:48px;margin-bottom:16px}
.sens-title{
  font-family:'Orbitron',sans-serif;
  font-size:16px;
  color:var(--pink);
  margin-bottom:12px;
  letter-spacing:.05em;
}
.sens-text{font-size:13px;color:var(--muted);line-height:1.6;margin-bottom:24px}
.sens-btns{display:flex;gap:12px;justify-content:center}
.btn{
  padding:11px 22px;
  border-radius:10px;
  border:1px solid var(--border);
  cursor:pointer;
  font-family:'Orbitron',sans-serif;
  font-size:11px;
  letter-spacing:.04em;
  transition:.2s;
}
.btn.primary{
  background:linear-gradient(135deg,var(--cyan),var(--purple));
  border:none;color:#fff;
}
.btn.primary:hover{opacity:.85}
.btn.secondary{background:transparent;color:var(--muted)}
.btn.secondary:hover{border-color:var(--muted);color:#fff}

/* ── MODE MODAL ── */
.mode-modal{
  display:none;
  position:fixed;inset:0;
  background:rgba(0,0,0,0.85);
  z-index:600;
  justify-content:center;
  align-items:center;
}
.mode-modal.open{display:flex}
.mode-box{
  background:rgba(8,8,22,0.98);
  border:1px solid var(--border);
  border-radius:18px;
  padding:32px;
  width:380px;
  box-shadow:0 20px 60px rgba(0,0,0,0.8);
}
.mode-box h2{
