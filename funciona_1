          <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px">
            <span>Recuerdos sincronizados</span><span style="color:var(--cyan)">119 / 127</span>
          </div>
          <div class="prog-wrap"><div class="prog-bar" style="width:94%"></div></div>
        </div>
        <div>
          <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px">
            <span>Audio espacial</span><span style="color:var(--cyan)">88%</span>
          </div>
          <div class="prog-wrap"><div class="prog-bar" style="width:88%"></div></div>
        </div>
        <div>
          <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px">
            <span>Datos biométricos</span><span style="color:var(--cyan)">100%</span>
          </div>
          <div class="prog-wrap"><div class="prog-bar" style="width:100%"></div></div>
        </div>
      </div>
      <div style="margin-top:18px;padding:12px;background:rgba(0,229,255,0.05);border-radius:10px;border:1px solid rgba(0,229,255,0.1)">
        <div style="font-size:11px;color:var(--cyan);font-family:'Orbitron',sans-serif;margin-bottom:4px">🔒 CIFRADO ACTIVO</div>
        <div style="font-size:11px;color:var(--muted)">Tus recuerdos están protegidos por tu firma biométrica única. Nadie más puede acceder.</div>
      </div>
    </div>
  </div>
</section>

</main>

<!-- ══════════ FLOATING AI BUTTON ══════════ -->
<button class="ai-fab" onclick="toggleAI()" title="Asistente IA">✦</button>

<!-- ══════════ AI PANEL ══════════ -->
<div class="ai-panel" id="aiPanel">
  <div class="ai-panel-hdr">
    <div class="ai-dot"></div>
    <span class="ai-title">ASISTENTE TIMEBACK</span>
    <button class="ai-close" onclick="toggleAI()">×</button>
  </div>
  <div class="ai-messages" id="aiMessages">
    <div class="msg assistant">
      Hola Marco. Puedo ayudarte a buscar recuerdos, analizar tus emociones o responder preguntas sobre TimeBack. ¿Qué quieres recordar hoy?
    </div>
  </div>
  <div class="ai-input-row">
    <input class="ai-input" id="aiInput" type="text" placeholder="¿Qué recuerdo buscas?…" onkeydown="if(event.key==='Enter')sendAI()">
    <button class="ai-send" id="aiSend" onclick="sendAI()">➤</button>
  </div>
</div>

<!-- ══════════ IMMERSIVE MODAL ══════════ -->
<div class="modal" id="memModal">
  <button class="modal-close" onclick="closeMemory()">×</button>
  <div class="sync-phase" id="syncPhase">ESTABLECIENDO ENLACE NEURONAL…</div>
  <div class="pov-wrap" id="povWrap">
    <div class="pov-bg" id="povBg"></div>
    <div class="pov-vignette"></div>
    <div class="pov-hud">
      <div class="hud-row">
        <div class="hud-el" id="hudTitle">REPRODUCIENDO</div>
        <div class="hud-el">P.O.V INMERSIVO</div>
      </div>
      <div class="hud-center" id="hudCenter">Conexión completada. Reviviendo experiencia.</div>
      <div class="hud-row">
        <div>
          <div class="bpm-live" id="liveBpmModal">—</div>
          <div class="bpm-label">BPM REGISTRADO</div>
        </div>
        <div class="emo-hud" id="hudEmo">SENSOR EMOCIONAL ACTIVO</div>
        <div>
          <div class="playback-controls">
            <button class="ctrl-btn">⏮</button>
            <button class="ctrl-btn main" id="playBtn" onclick="togglePlay()">⏸</button>
            <button class="ctrl-btn">⏭</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ══════════ SENSITIVE MODAL ══════════ -->
<div class="sens-modal" id="sensModal">
  <div class="sens-box">
    <div class="sens-icon">⚠️</div>
    <div class="sens-title">RECUERDO SENSIBLE</div>
    <p class="sens-text">
      Este recuerdo ha sido marcado como emocionalmente intenso.
      El modo protegido limita las reproducciones y activa filtros de bienestar.<br><br>
      <strong style="color:#fff" id="sensTitle"></strong>
    </p>
    <div class="sens-btns">
      <button class="btn secondary" onclick="closeSensitive()">Cancelar</button>
      <button class="btn primary" onclick="enterProtected()">Entrar en modo protegido</button>
    </div>
  </div>
</div>

<!-- ══════════ MODE MODAL ══════════ -->
<div class="mode-modal" id="modeModal">
  <div class="mode-box">
    <h2>Modo de grabación</h2>
    <p>Selecciona cómo deben registrarse tus recuerdos</p>
    <div class="mode-options">
      <div class="mode-opt" onclick="selectMode('MANUAL','manual')">
        <div class="opt-icon">🎯</div>
        <h4>Manual</h4>
        <p>Tú decides cuándo empieza y termina la grabación</p>
      </div>
      <div class="mode-opt selected" onclick="selectMode('AUTO','auto')">
        <div class="opt-icon">⚡</div>
        <h4>Auto-supervisado</h4>
        <p>El sistema detecta momentos importantes, tú confirmas</p>
      </div>
      <div class="mode-opt" onclick="selectMode('EVENTOS','eventos')">
        <div class="opt-icon">📅</div>
        <h4>Solo eventos clave</h4>
        <p>Solo graba cuando detecta contextos predefinidos</p>
      </div>
    </div>
    <div class="mode-footer">
      <button class="btn secondary" onclick="closeModeModal()">Cancelar</button>
      <button class="btn primary" onclick="closeModeModal()">Aplicar</button>
    </div>
  </div>
</div>

<script>
/* ─── NAVIGATION ─── */
function navigate(target){
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  document.querySelector(`[data-target="${target}"]`)?.classList.add('active');
  document.getElementById(target)?.classList.add('active');
  if(target==='analitica') animateBars();
}
document.querySelectorAll('.nav-item').forEach(item=>{
  item.addEventListener('click',function(){
    navigate(this.dataset.target);
  });
});

/* ─── LIVE BPM ─── */
let bpm=72;
setInterval(()=>{
  bpm=Math.max(60,Math.min(100,bpm+(Math.random()>.5?1:-1)));
  const el=document.getElementById('liveBpm');
  if(el) el.textContent=Math.round(bpm);
},1200);

/* ─── FILTER & SEARCH ─── */
function filterMem(cat,btn){
  document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.mem-card').forEach(c=>{
    const cats=c.dataset.cat||'';
    c.classList.toggle('hidden',cat!=='todos'&&!cats.includes(cat));
  });
}
document.getElementById('memSearch').addEventListener('input',function(){
  const q=this.value.toLowerCase();
  document.querySelectorAll('.mem-card').forEach(c=>{
    const text=(c.innerText+' '+(c.dataset.tags||'')).toLowerCase();
    c.classList.toggle('hidden',q.length>0&&!text.includes(q));
  });
});

/* ─── MEMORY MODAL ─── */
let playing=true;
function openMemory(title, img, sensitive, bpmVal){
  const modal=document.getElementById('memModal');
  const phase=document.getElementById('syncPhase');
  const pov=document.getElementById('povWrap');
  modal.classList.add('open');
  pov.style.display='none';
  phase.style.display='block';
  playing=true;
  document.getElementById('playBtn').textContent='⏸';
  const phases=['ESTABLECIENDO ENLACE NEURONAL…','SINTONIZANDO CÓRTEX VISUAL…','CARGANDO MEMORIA EMOCIONAL…'];
  let i=0;
  phase.textContent=phases[0];
  const interval=setInterval(()=>{
    i++;
    if(i<phases.length) phase.textContent=phases[i];
    else {
      clearInterval(interval);
      phase.style.display='none';
      pov.style.display='block';
      document.getElementById('povBg').style.backgroundImage=`url('${img}')`;
      document.getElementById('hudTitle').textContent='REPRODUCIENDO: '+title.toUpperCase();
      document.getElementById('liveBpmModal').textContent=bpmVal||'—';
      document.getElementById('hudEmo').textContent='SENSOR EMOCIONAL ACTIVO';
    }
  },1000);
}
function closeMemory(){
  document.getElementById('memModal').classList.remove('open');
}
function togglePlay(){
  playing=!playing;
  document.getElementById('playBtn').textContent=playing?'⏸':'▶';
}

/* ─── SENSITIVE ─── */
let pendingSensitive='';
function openSensitive(title){
  pendingSensitive=title;
  document.getElementById('sensTitle').textContent=title;
  document.getElementById('sensModal').classList.add('open');
}
function closeSensitive(){
  document.getElementById('sensModal').classList.remove('open');
  pendingSensitive='';
}
function enterProtected(){
  closeSensitive();
  const modal=document.getElementById('memModal');
  const phase=document.getElementById('syncPhase');
  const pov=document.getElementById('povWrap');
  modal.classList.add('open');
  pov.style.display='none';
  phase.style.display='block';
  phase.textContent='ACTIVANDO MODO PROTEGIDO…';
  setTimeout(()=>{
    phase.style.display='none';
    pov.style.display='block';
    document.getElementById('povBg').style.background='linear-gradient(135deg,#1a0428,#060613)';
    document.getElementById('povBg').style.backgroundImage='none';
    document.getElementById('hudTitle').textContent='MODO PROTEGIDO: '+pendingSensitive.toUpperCase();
    document.getElementById('liveBpmModal').textContent='●';
    document.getElementById('hudEmo').textContent='FILTROS EMOCIONALES ON';
    document.getElementById('hudCenter').textContent='Reproducción limitada. Filtros de bienestar activos.';
  },1800);
}

/* ─── MODE MODAL ─── */
function openModeModal(){ document.getElementById('modeModal').classList.add('open') }
function closeModeModal(){ document.getElementById('modeModal').classList.remove('open') }
function selectMode(label,id){
  document.querySelectorAll('.mode-opt').forEach(o=>o.classList.remove('selected'));
  event.currentTarget.classList.add('selected');
  document.getElementById('modeName').textContent=label;
  const colors={manual:'#9D00FF',auto:'#00E5FF',eventos:'#FF2D78'};
  document.getElementById('modeIndicator').style.color=colors[id]||'#00E5FF';
}

/* ─── ANALYTICS BARS ANIMATION ─── */
function animateBars(){
  setTimeout(()=>{
    document.querySelectorAll('.bar-fill').forEach(b=>{
      b.style.width=b.dataset.w;
    });
  },100);
}

/* ─── HEATMAP ─── */
(function buildHeatmap(){
  const wrap=document.getElementById('heatmap');
  if(!wrap)return;
  for(let i=0;i<35;i++){
    const d=document.createElement('div');
    const v=Math.random();
    const a=v>.8?.8:v>.5?.4:.1;
    d.style.cssText=`width:100%;aspect-ratio:1;border-radius:4px;background:rgba(0,229,255,${a});cursor:pointer;transition:.2s`;
    d.title=`${Math.floor(Math.random()*5)+1} recuerdos`;
    d.onmouseenter=()=>{d.style.outline='1px solid var(--cyan)'};
    d.onmouseleave=()=>{d.style.outline='none'};
    wrap.appendChild(d);
  }
})();

/* ─── AI PANEL ─── */
const MEMORIES=[
  {keys:['concierto','coldplay','música','musica'],name:'Concierto Coldplay',img:'https://images.unsplash.com/photo-1459749411175-04bf5292ceea?w=1200&q=80',bpm:128},
  {keys:['playa','familia','verano','mar'],name:'Playa con familia',img:'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=1200&q=80',bpm:85},
  {keys:['graduaci','universidad','diploma'],name:'Graduación universitaria',img:'https://images.unsplash.com/photo-1523050854058-8df90110c9f1?w=1200&q=80',bpm:118},
  {keys:['alps','alpes','montaña','senderismo','naturaleza'],name:'Senderismo en los Alpes',img:'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1200&q=80',bpm:94},
  {keys:['max','perro','mascota','paseo'],name:'Paseo con Max',img:'https://images.unsplash.com/photo-1511895426328-dc8714191300?w=1200&q=80',bpm:71},
];
let aiOpen=false;
const aiHistory=[];
function toggleAI(){
  aiOpen=!aiOpen;
  document.getElementById('aiPanel').classList.toggle('open',aiOpen);
  if(aiOpen) document.getElementById('aiInput').focus();
}
function addMsg(text,role){
  const msgs=document.getElementById('aiMessages');
  const d=document.createElement('div');
  d.className=`msg ${role}`;
  d.textContent=text;
  msgs.appendChild(d);
  msgs.scrollTop=msgs.scrollHeight;
  return d;
}
async function sendAI(){
  const input=document.getElementById('aiInput');
  const btn=document.getElementById('aiSend');
  const q=input.value.trim();
  if(!q)return;
  input.value='';
  btn.disabled=true;
  addMsg(q,'user');
  aiHistory.push({role:'user',content:q});

  // Check if query matches a local memory first
  const qLow=q.toLowerCase();
  const match=MEMORIES.find(m=>m.keys.some(k=>qLow.includes(k)));
  if(match){
    const thinkEl=addMsg('Buscando en tu biblioteca emocional…','assistant thinking');
    setTimeout(()=>{
      thinkEl.classList.remove('thinking');
      thinkEl.textContent=`Encontré el recuerdo "${match.name}" en tu bóveda. ¿Quieres revivirlo ahora?`;
      aiHistory.push({role:'assistant',content:thinkEl.textContent});

      const openBtn=document.createElement('button');
      openBtn.textContent='▶ Abrir recuerdo';
      openBtn.style.cssText='margin-top:8px;display:block;background:linear-gradient(135deg,var(--cyan),var(--purple));border:none;border-radius:8px;color:#fff;padding:7px 14px;cursor:pointer;font-size:12px;';
      openBtn.onclick=()=>{ toggleAI(); openMemory(match.name,match.img,false,match.bpm); };
      thinkEl.appendChild(document.createElement('br'));
      thinkEl.appendChild(openBtn);
      btn.disabled=false;
    },800);
    return;
  }

  // Call Anthropic API for general questions
  const thinkEl=addMsg('Pensando…','assistant thinking');
  try{
    const systemPrompt=`Eres el asistente de TimeBack, una aplicación de lentillas inteligentes que guarda y reproduce recuerdos desde la perspectiva del usuario. El usuario se llama Marco, tiene 21 años, y tiene 127 recuerdos guardados. Algunos recuerdos importantes: Concierto Coldplay (15 mayo 2026, euforia 96%, BPM 128), Playa con familia (12 mayo, paz 88%, BPM 85), Graduación universitaria (jun 2025, alegría 99%), Senderismo Alpes (dic 2025). Responde de forma concisa, empática y útil en español. Si el usuario pregunta por un recuerdo, descríbelo brevemente. Si pregunta algo genérico sobre la app, explica cómo funciona TimeBack.`;
    const body={
      model:'claude-sonnet-4-20250514',
      max_tokens:1000,
      system:systemPrompt,
      messages:[...aiHistory]
    };
    const res=await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify(body)
    });
    const data=await res.json();
    const answer=data.content?.find(b=>b.type==='text')?.text||'No pude obtener respuesta.';
    thinkEl.classList.remove('thinking');
    thinkEl.textContent=answer;
    aiHistory.push({role:'assistant',content:answer});
  }catch(e){
    thinkEl.classList.remove('thinking');
    thinkEl.textContent='Lo siento, hubo un problema con el asistente. Comprueba tu conexión.';
  }
  btn.disabled=false;
}
</script>
</body>
